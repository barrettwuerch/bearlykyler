# OS cruft
.DS_Store
._*
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Python bytecode from serve.py
__pycache__/
*.py[cod]

# Cloudflare / Node tooling, should it ever be added
node_modules/
.wrangler/
dist/

# Local secrets — never commit these
.dev.vars
.env
.env.*

# Scratch pages written into the web root by the verification scripts. Fourteen
# of them reached production once, because the deploy serves site/ wholesale and
# `git add -A` does not know which files were meant to be there.
site/__*.html
site/export-*.html
